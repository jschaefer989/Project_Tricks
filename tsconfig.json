{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "Node",
    "strict": true,
    "baseUrl": ".",
    "sourceMap": true,
    "types": ["lua-types/jit"],
    "declaration": true,
    "paths": {
      "*": ["./*"]
    }
  },
  "tstl": {
    "luaTarget": "JIT",
    "noResolvePaths": [
      "Libraries.GameStateManager-main.gamestateManager",
      "Libraries.Lovely-Toasts-main.lovelyToasts",
      "Libraries.jsonlua-master",
      "Libraries.push",
      "Libraries.suit-master.suit",
      "Libraries.SYSL-Text-master.example.main"
    ]
  },
  "include": [
    "*.ts",
    "TSTL/Declarations/**/*.d.ts",
    "Cards/**/*.ts",
    "Enemies/**/*.ts",
    "Screens/**/*.ts",
    "Draw/**/*.ts"
, "Assets/Asset.ts", "Assets/Asset.d.ts", "Assets/AssetManager.ts", "Assets/AssetManager.d.ts", "Assets/CardAssets.ts", "Assets/CardAssets.d.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
